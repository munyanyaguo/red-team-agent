# ==============================================================================
# Red Team Agent - Environment Configuration Template
# ==============================================================================
# Copy to .env and fill in values: cp .env.example .env
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Core Application
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Generate strong keys: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-strong-random-value-at-least-64-chars
JWT_SECRET_KEY=change-me-to-a-different-strong-random-value
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Database (PostgreSQL)
POSTGRES_DB=redteam_db
POSTGRES_USER=redteam
POSTGRES_PASSWORD=change-me-strong-db-password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20

# Redis
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# AI API Keys (at least one required for AI features)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Security
ENABLE_EXPLOITATION=false
MAX_SCAN_TIMEOUT=300
AUTHORIZED_DOMAINS=
MAX_REQUEST_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_DEFAULT=200/day;50/hour
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_SCAN=10/hour
RATE_LIMIT_EXPLOIT=5/hour

# n8n Workflow Automation
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-strong-n8n-password

# TLS / HTTPS
TLS_MODE=selfsigned
DOMAIN_NAME=redteam.example.com
LETSENCRYPT_EMAIL=admin@example.com

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-grafana-password
